{% extends 'admin/base_admin.html.twig' %}

{% block title %}Signalements{% endblock %}

{% block admin_content %}
<style>
.rep-table { width:100%; border-collapse:separate; border-spacing:0; }
.rep-table thead tr { background:#12122a; }
.rep-table thead th {
    padding:12px 16px; font-size:11px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:#6b7280; border-bottom:1px solid #1e1e3a; white-space:nowrap;
}
.rep-table tbody tr { transition:background .15s; border-bottom:1px solid #1a1a30; }
.rep-table tbody tr:hover { background:#14142a; }
.rep-table tbody td { padding:13px 16px; vertical-align:middle; }

.rbadge-id { background:#1e1e2a; color:#818cf8; border-radius:6px; padding:3px 9px; font-size:12px; font-weight:700; }

.rbadge-status-pending   { background:#2e1506; color:#fb923c; border:1px solid #4a2808; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }
.rbadge-status-reviewed  { background:#0a1a2e; color:#7dd3fc; border:1px solid #0e2a4a; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }
.rbadge-status-dismissed { background:#1e1e2a; color:#6b7280; border:1px solid #2a2a3a; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }

.rbadge-reason-spam           { background:#2b0d0d; color:#f87171; border:1px solid #3d1a1a; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; }
.rbadge-reason-inappropriate  { background:#2e1506; color:#fb923c; border:1px solid #4a2808; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; }
.rbadge-reason-harassment     { background:#1e0a2e; color:#c084fc; border:1px solid #3a1a4a; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; }
.rbadge-reason-misinformation { background:#0a1a2e; color:#7dd3fc; border:1px solid #0e2a4a; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; }
.rbadge-reason-autre          { background:#1e1e2a; color:#94a3b8; border:1px solid #2a2a3a; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; }

.ract { display:flex; gap:6px; align-items:center; flex-wrap:nowrap; }
.rbtn {
    display:inline-flex; align-items:center; gap:4px;
    padding:5px 11px; border-radius:6px; font-size:12px; font-weight:500;
    text-decoration:none; border:1px solid #2a2a3a; cursor:pointer;
    background:#1a1a28; color:#94a3b8;
    transition:color .15s, border-color .15s; white-space:nowrap;
}
.rbtn:hover { color:#e0e0e0; border-color:#444; }
.rbtn-view    { color:#818cf8; border-color:#2e2e50; }
.rbtn-review  { color:#4ade80; border-color:#1a3d28; }
.rbtn-dismiss { color:#fb923c; border-color:#4a2808; }
.rbtn-del     { color:#f87171; border-color:#3d1f1f; }
.rbtn form, .rbtn button {
    margin:0; padding:0; background:none; border:none;
    color:inherit; font:inherit; font-size:12px; font-weight:500;
    cursor:pointer; display:inline;
}
</style>

<div class="page-header">
    <h1>Signalements</h1>
    <p>Examiner et modérer les commentaires signalés</p>
</div>

{# ===== FILTRES ===== #}
<div class="card" style="margin-bottom:20px">
    <div class="card-header"><h3 class="card-title">Filtres & Recherche</h3></div>
    <form method="GET" action="{{ path('admin_comment_reports_index') }}"
          style="display:flex;flex-wrap:wrap;gap:12px;padding:16px;align-items:flex-end">

        <div style="min-width:160px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Statut</label>
            <select name="status" style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
                <option value="all"       {{ status_filter == 'all'       ? 'selected' : '' }}>Tous</option>
                <option value="pending"   {{ status_filter == 'pending'   ? 'selected' : '' }}>En attente</option>
                <option value="reviewed"  {{ status_filter == 'reviewed'  ? 'selected' : '' }}>Traités</option>
                <option value="dismissed" {{ status_filter == 'dismissed' ? 'selected' : '' }}>Ignorés</option>
            </select>
        </div>

        <div style="min-width:190px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Raison</label>
            <select name="reason" style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
                <option value="all" {{ reason_filter == 'all' ? 'selected' : '' }}>Toutes les raisons</option>
                {% for reason in all_reasons %}
                    {% set reasonLabel = reason == 'spam' ? 'Spam'
                        : (reason == 'inappropriate' ? 'Inapproprié'
                        : (reason == 'harassment' ? 'Harcèlement'
                        : (reason == 'misinformation' ? 'Fausse information' : 'Autre'))) %}
                    <option value="{{ reason }}" {{ reason_filter == reason ? 'selected' : '' }}>{{ reasonLabel }}</option>
                {% endfor %}
            </select>
        </div>

        <div style="display:flex;gap:8px">
            <button type="submit" style="padding:8px 18px;border-radius:6px;border:none;background:#6c63ff;color:#fff;font-size:13px;cursor:pointer;font-weight:600">🔍 Filtrer</button>
            <a href="{{ path('admin_comment_reports_index') }}" style="padding:8px 18px;border-radius:6px;border:1px solid #555;color:#aaa;font-size:13px;text-decoration:none;display:flex;align-items:center">✕ Reset</a>
        </div>
    </form>
</div>

{# ===== FLASH MESSAGES ===== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:#0d2b1a;color:#4ade80;border:1px solid #1a3d28;font-size:13px;font-weight:600;">✅ {{ message }}</div>
    {% endfor %}
{% endfor %}

{# ===== TABLEAU ===== #}
{% set pending_count   = reports|filter(r => r.status == 'pending')|length %}
{% set reviewed_count  = reports|filter(r => r.status == 'reviewed')|length %}
{% set dismissed_count = reports|filter(r => r.status == 'dismissed')|length %}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            Liste des Signalements
            <span style="font-size:13px;color:#888;font-weight:normal;margin-left:8px">
                ({{ reports|length }} résultat{{ reports|length > 1 ? 's' : '' }})
            </span>
        </h3>
        <div style="display:flex;gap:10px;align-items:center">
            <span style="background:#2e1506;color:#fb923c;border:1px solid #4a2808;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:700">⏳ {{ pending_count }} en attente</span>
            <span style="background:#0a1a2e;color:#7dd3fc;border:1px solid #0e2a4a;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:700">✅ {{ reviewed_count }} traités</span>
            <span style="background:#1e1e2a;color:#6b7280;border:1px solid #2a2a3a;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:700">🚫 {{ dismissed_count }} ignorés</span>
        </div>
    </div>

    {% if reports is empty %}
        <div style="padding:40px;text-align:center;color:#4b5563;font-size:14px">Aucun signalement ne correspond à vos filtres.</div>
    {% else %}
    <div style="overflow-x:auto">
    <table class="rep-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Commentaire</th>
                <th>Raison</th>
                <th>Statut</th>
                <th>Signalé par</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for report in reports %}
                {% set statusClass = 'rbadge-status-' ~ report.status %}
                {% set statusLabel = report.status == 'pending' ? 'En attente'
                    : (report.status == 'reviewed' ? 'Traité' : 'Ignoré') %}
                {% set reasonKey = report.reason|lower|replace({' ': '-', '_': '-'}) %}
                {% set reasonClass = 'rbadge-reason-' ~ reasonKey %}
                {% set reasonLabel = report.reason == 'spam' ? 'Spam'
                    : (report.reason == 'inappropriate' ? 'Inapproprié'
                    : (report.reason == 'harassment' ? 'Harcèlement'
                    : (report.reason == 'misinformation' ? 'Fausse information' : 'Autre'))) %}
            <tr>
                <td><span class="rbadge-id">#{{ report.id }}</span></td>
                <td>
                    {% if report.commentaire %}
                        <div style="font-size:13px;font-weight:600;color:#e2e8f0">
                            {{ report.commentaire.blog ? report.commentaire.blog.titre : 'Article supprimé' }}
                        </div>
                        <div style="font-size:11px;color:#4b5563;margin-top:3px">
                            {{ report.commentaire.contenu|slice(0,100) }}{% if report.commentaire.contenu|length > 100 %}…{% endif %}
                        </div>
                    {% else %}
                        <span style="color:#4b5563;font-size:12px">Commentaire supprimé</span>
                    {% endif %}
                </td>
                <td><span class="{{ reasonClass }}">{{ reasonLabel }}</span></td>
                <td><span class="{{ statusClass }}">{{ statusLabel }}</span></td>
                <td>
                    <span style="background:#1e1e2a;color:#94a3b8;border:1px solid #2a2a3a;border-radius:6px;padding:3px 9px;font-size:12px">
                        {{ report.user ? ((report.user.prenom|default('') ~ ' ' ~ report.user.nom|default(''))|trim ?: report.user.userIdentifier) : 'Inconnu' }}
                    </span>
                </td>
                <td><span style="font-size:12px;color:#94a3b8">{{ report.createdAt ? report.createdAt|date('d/m/Y H:i') : '—' }}</span></td>
                <td>
                    <div class="ract">
                        {% if report.commentaire and report.commentaire.blog %}
                            <a href="{{ path('app_blog_show', {id: report.commentaire.blog.id}) }}" class="rbtn rbtn-view">👁 Voir</a>
                        {% endif %}

                        {% if report.status != 'reviewed' %}
                            <span class="rbtn rbtn-review">
                                <form method="post" action="{{ path('admin_comment_report_review', {id: report.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_review_report_' ~ report.id) }}">
                                    <input type="hidden" name="status_filter" value="{{ status_filter }}">
                                    <input type="hidden" name="reason_filter" value="{{ reason_filter }}">
                                    <button type="submit">✅ Traiter</button>
                                </form>
                            </span>
                        {% endif %}

                        {% if report.status != 'dismissed' %}
                            <span class="rbtn rbtn-dismiss">
                                <form method="post" action="{{ path('admin_comment_report_dismiss', {id: report.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_dismiss_report_' ~ report.id) }}">
                                    <input type="hidden" name="status_filter" value="{{ status_filter }}">
                                    <input type="hidden" name="reason_filter" value="{{ reason_filter }}">
                                    <button type="submit">🚫 Ignorer</button>
                                </form>
                            </span>
                        {% endif %}

                        {% if report.commentaire %}
                            <span class="rbtn rbtn-del">
                                <form method="post" action="{{ path('admin_comment_report_delete_comment', {id: report.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_report_comment_' ~ report.id) }}">
                                    <input type="hidden" name="status_filter" value="{{ status_filter }}">
                                    <input type="hidden" name="reason_filter" value="{{ reason_filter }}">
                                    <button type="submit">🗑 Supprimer</button>
                                </form>
                            </span>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}
</div>

<footer class="copyright">Copyright &copy; 2026 VoyageLoisir</footer>
{% endblock %}
