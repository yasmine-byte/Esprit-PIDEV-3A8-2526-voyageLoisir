{% extends 'admin/base_admin.html.twig' %}

{% block title %}Détail de l'article{% endblock %}

{% block admin_content %}
<style>
/* ===== BADGES STATUT ===== */
.sbadge-publie    { background:#0d2b1a; color:#4ade80; border:1px solid #1a3d28; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }
.sbadge-brouillon { background:#2e1e06; color:#fbbf24; border:1px solid #4a3010; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }
.sbadge-attente   { background:#0a1a2e; color:#7dd3fc; border:1px solid #0e2a4a; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }

/* ===== BOUTONS (même système que destination) ===== */
.sact { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
.sbtn {
    display:inline-flex; align-items:center; gap:4px;
    padding:5px 11px; border-radius:6px; font-size:12px; font-weight:500;
    text-decoration:none; border:1px solid #2a2a3a; cursor:pointer;
    background:#1a1a28; color:#94a3b8;
    transition:color .15s, border-color .15s; white-space:nowrap;
}
.sbtn:hover { color:#e0e0e0; border-color:#444; }
.sbtn-back    { color:#818cf8; border-color:#2e2e50; }
.sbtn-edit    { color:#fbbf24; border-color:#4a3010; }
.sbtn-publish { color:#4ade80; border-color:#1a3d28; }
.sbtn-unpub   { color:#fb923c; border-color:#4a2808; }
.sbtn-del     { color:#f87171; border-color:#3d1f1f; }
.sbtn form, .sbtn button {
    margin:0; padding:0; background:none; border:none;
    color:inherit; font:inherit; font-size:12px; font-weight:500;
    cursor:pointer; display:inline;
}

/* ===== HERO IMAGE ===== */
.hero-wrap {
    width:100%; height:300px; overflow:hidden; border-radius:10px;
    background:#12122a; border:1px solid #2a2a3a;
    display:flex; align-items:center; justify-content:center;
    color:#4b5563; font-size:42px;
}
.hero-wrap img { width:100%; height:100%; object-fit:cover; display:block; }

/* ===== SHOW GRID ===== */
.show-grid { display:grid; grid-template-columns:1fr 280px; gap:20px; margin-top:20px; }

/* ===== INFO CARDS ===== */
.info-card { background:#12122a; border:1px solid #2a2a4a; border-radius:12px; padding:22px; }
.info-card-title { margin:0 0 16px; font-size:14px; font-weight:700; color:#fff; border-left:3px solid #6c63ff; padding-left:10px; }

/* ===== META LIST ===== */
.meta-list { display:grid; gap:14px; }
.meta-item small { display:block; color:#6b7280; font-size:11px; text-transform:uppercase; letter-spacing:.06em; margin-bottom:3px; }
.meta-item strong { color:#e2e8f0; font-size:13px; }

/* ===== STAT BOXES ===== */
.stat-row { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.stat-box { background:#1a1a2e; border:1px solid #2a2a3a; border-radius:10px; padding:14px; text-align:center; }
.stat-box small { display:block; color:#6b7280; font-size:11px; margin-bottom:6px; }
.stat-box strong { font-size:22px; font-weight:800; }

/* ===== CONTENT BODY ===== */
.content-body p { margin:0 0 12px; line-height:1.85; color:#d1d5db; font-size:13px; }

/* ===== COMMENTS ===== */
.comment-list { display:grid; gap:10px; }
.comment-card { background:#1a1a2e; border:1px solid #2a2a3a; border-radius:10px; padding:14px; transition:background .15s; }
.comment-card:hover { background:#14142a; }
.comment-card--reported { border-color:#3d1a1a; background:#1e1212; }
.comment-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:10px; flex-wrap:wrap; }
.comment-avatar {
    width:36px; height:36px; border-radius:50%; flex-shrink:0;
    background:#1e1e3a; border:1px solid #2a2a4a;
    color:#818cf8; display:inline-flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:700; text-transform:uppercase;
}
.comment-user-row { display:flex; align-items:center; gap:10px; }
.comment-meta strong { color:#e2e8f0; display:block; font-size:13px; }
.comment-meta span { color:#4b5563; font-size:11px; }
.cbadge-ok  { background:#0d2b1a; color:#4ade80; border:1px solid #1a3d28; border-radius:20px; padding:2px 9px; font-size:11px; font-weight:700; }
.cbadge-rep { background:#2b0d0d; color:#f87171; border:1px solid #3d1a1a; border-radius:20px; padding:2px 9px; font-size:11px; font-weight:700; }
.comment-body { color:#d1d5db; font-size:13px; margin:0 0 8px; line-height:1.7; }
.cact { display:flex; gap:6px; margin-top:8px; }
.cbtn {
    display:inline-flex; align-items:center; gap:4px;
    padding:4px 10px; border-radius:6px; font-size:12px; font-weight:500;
    border:1px solid #2a2a3a; background:#1a1a28; color:#94a3b8; cursor:pointer;
    transition:color .15s, border-color .15s;
}
.cbtn form, .cbtn button { margin:0; padding:0; background:none; border:none; color:inherit; font:inherit; cursor:pointer; }
.cbtn-del  { color:#f87171; border-color:#3d1f1f; }
.cbtn-hide { color:#94a3b8; border-color:#2a2a3a; }
.reaction-chip {
    display:inline-flex; align-items:center; gap:4px;
    padding:3px 8px; border-radius:20px; border:1px solid #2a2a3a;
    background:#1e1e2a; color:#d1d5db; font-size:11px; font-weight:600;
    margin-right:4px; margin-bottom:4px;
}
@media(max-width:900px){ .show-grid { grid-template-columns:1fr; } .stat-row { grid-template-columns:1fr 1fr; } }
</style>

{% set pending_report_comment_ids = pending_report_comment_ids|default([]) %}
{% set comment_reaction_counts    = comment_reaction_counts|default({}) %}
{% set coverImage = blog.imageCouverture ?: '' %}

{% if blog.publicationRequested is defined and blog.publicationRequested and not blog.status %}
    {% set statusKey = 'attente' %}{% set statusTxt = 'En attente' %}
{% elseif blog.status %}
    {% set statusKey = 'publie' %}{% set statusTxt = 'Publié' %}
{% else %}
    {% set statusKey = 'brouillon' %}{% set statusTxt = 'Brouillon' %}
{% endif %}

{# ===== PAGE HEADER ===== #}
<div class="page-header">
    <h1>Détail de l'article</h1>
    <p>Informations, statistiques et commentaires</p>
</div>

{# ===== CARD TITRE + ACTIONS ===== #}
<div class="card">
    <div class="card-header">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0">
            <span style="font-size:15px;font-weight:700;color:#e2e8f0">{{ blog.titre }}</span>
            <span class="sbadge-{{ statusKey }}">{{ statusTxt }}</span>
        </div>
        <div class="sact">
            <a href="{{ path('admin_blogs') }}" class="sbtn sbtn-back">← Retour</a>
            <a href="{{ path('app_blog_edit', {'id': blog.id}) }}" class="sbtn sbtn-edit">✏️ Modifier</a>
            <span class="sbtn {{ blog.status ? 'sbtn-unpub' : 'sbtn-publish' }}">
                <form method="post" action="{{ path('admin_blog_workflow', {'id': blog.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_workflow_blog_' ~ blog.id) }}">
                    <input type="hidden" name="action" value="{{ blog.status ? 'draft' : 'publish' }}">
                    <button type="submit">{{ blog.status ? '⏸ Dépublier' : '✅ Publier' }}</button>
                </form>
            </span>
            <span class="sbtn sbtn-del">
                <form method="post" action="{{ path('admin_blog_delete', {'id': blog.id}) }}" onsubmit="return confirm('Supprimer cet article ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_blog_' ~ blog.id) }}">
                    <button type="submit">🗑 Supprimer</button>
                </form>
            </span>
        </div>
    </div>
    <div style="padding:0 20px 20px">
        <div class="hero-wrap">
            {% if coverImage %}<img src="{{ coverImage }}" alt="{{ blog.titre }}">{% else %}🖼{% endif %}
        </div>
    </div>
</div>

{# ===== GRID : INFOS + STATS/ML ===== #}
<div class="show-grid">

    <div class="info-card">
        <div class="info-card-title">Informations générales</div>
        <div class="meta-list">
            <div class="meta-item"><small>Auteur</small><strong>{{ blog.authorId ?: 'Utilisateur' }}</strong></div>
            <div class="meta-item"><small>Date de création</small><strong>{{ blog.dateCreation ? blog.dateCreation|date('d/m/Y H:i') : '—' }}</strong></div>
            <div class="meta-item"><small>Date de publication</small><strong>{{ blog.datePublication ? blog.datePublication|date('d/m/Y H:i') : 'Non publié' }}</strong></div>
            <div class="meta-item"><small>Slug</small><strong style="color:#818cf8">{{ blog.slug ?: '—' }}</strong></div>
            <div class="meta-item"><small>Statut</small><span class="sbadge-{{ statusKey }}">{{ statusTxt }}</span></div>
        </div>
    </div>

    <div style="display:grid;gap:16px;align-content:start">
        <div class="info-card">
            <div class="info-card-title">Statistiques</div>
            <div class="stat-row">
                <div class="stat-box"><small>👁 Vues</small><strong style="color:#3b82f6">{{ views_count }}</strong></div>
                <div class="stat-box"><small>❤️ Réactions</small><strong style="color:#e11d48">{{ totalReactions }}</strong></div>
                <div class="stat-box"><small>💬 Commentaires</small><strong style="color:#a78bfa">{{ comments|length }}</strong></div>
            </div>
        </div>
        <div class="info-card">
            <div class="info-card-title">Suggestion ML</div>
            {% if ml_suggestion is defined and ml_suggestion %}
                <div style="background:#1a1a2e;border:1px solid #2a2a4a;border-radius:8px;padding:12px">
                    <div style="color:#a78bfa;font-weight:700;font-size:14px">{{ ml_suggestion.categorie|default('—') }}</div>
                    <div style="color:#6b7280;font-size:12px;margin-top:4px">Confiance : {{ ml_suggestion.confiance|default(0) }}%</div>
                </div>
            {% else %}
                <span style="color:#4b5563;font-size:13px">Aucune suggestion disponible.</span>
            {% endif %}
        </div>
    </div>
</div>

{# ===== CONTENU ===== #}
<div class="card" style="margin-top:20px">
    <div class="card-header"><h3 class="card-title">Contenu de l'article</h3></div>
    <div style="padding:20px">
        <div class="content-body">
            {% for paragraph in blog.contenu|split('\n') %}
                {% if paragraph|trim is not empty %}<p>{{ paragraph|trim }}</p>{% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{# ===== COMMENTAIRES ===== #}
<div class="card" style="margin-top:20px">
    <div class="card-header">
        <h3 class="card-title">
            Commentaires
            <span style="font-size:13px;color:#888;font-weight:normal;margin-left:8px">
                ({{ comments|length }} résultat{{ comments|length > 1 ? 's' : '' }})
            </span>
        </h3>
    </div>

    {% if comments is empty %}
        <div style="padding:40px;text-align:center;color:#4b5563;font-size:14px">Aucun commentaire pour cet article.</div>
    {% else %}
    <div style="padding:16px 20px 20px">
        <div class="comment-list">
            {% for comment in comments %}
                {% set isReported = comment.id in pending_report_comment_ids %}
            <div class="comment-card {{ isReported ? 'comment-card--reported' : '' }}">
                <div class="comment-top">
                    <div class="comment-user-row">
                        <span class="comment-avatar">{{ comment.nomuser|default('U')|slice(0,2) }}</span>
                        <div class="comment-meta">
                            <strong>{{ comment.nomuser|default('Utilisateur') }}</strong>
                            <span>{{ comment.dateCreation ? comment.dateCreation|date('d/m/Y H:i') : '—' }}</span>
                        </div>
                    </div>
                    <span class="{{ isReported ? 'cbadge-rep' : 'cbadge-ok' }}">{{ isReported ? '🚨 Signalé' : '✅ Approuvé' }}</span>
                </div>

                <p class="comment-body">{{ comment.contenu }}</p>

                {% set reactions = comment_reaction_counts[comment.id]|default({}) %}
                {% if reactions is not empty %}
                    <div style="margin-bottom:6px">
                        {% for key, emoji in {'like':'👍','love':'❤️','haha':'😄','wow':'😮','sad':'😢','angry':'😡'} %}
                            {% set count = reactions[key]|default(0) %}
                            {% if count > 0 %}<span class="reaction-chip">{{ emoji }} {{ count }}</span>{% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="cact">
                    <span class="cbtn cbtn-del">
                        <form method="post" action="{{ path('admin_blog_comment_delete', {blog: blog.id, comment: comment.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token((comment_delete_token_prefix|default('admin_delete_comment_')) ~ comment.id) }}">
                            <button type="submit">🗑 Supprimer</button>
                        </form>
                    </span>
                    <span class="cbtn cbtn-hide">
                        <form method="post" action="{{ path('admin_blog_comment_hide', {blog: blog.id, comment: comment.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token((comment_hide_token_prefix|default('admin_hide_comment_')) ~ comment.id) }}">
                            <button type="submit">🚫 Masquer</button>
                        </form>
                    </span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

<footer class="copyright">Copyright &copy; 2026 VoyageLoisir</footer>
{% endblock %}
