{% extends 'admin/base_admin.html.twig' %}

{% block title %}Articles{% endblock %}

{% block admin_content %}
<style>
.blog-table { width:100%; border-collapse:separate; border-spacing:0; }
.blog-table thead tr { background:#12122a; }
.blog-table thead th {
    padding:12px 16px; font-size:11px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:#6b7280; border-bottom:1px solid #1e1e3a; white-space:nowrap;
}
.blog-table thead th a { color:inherit; text-decoration:none; }
.blog-table thead th a:hover { color:#e0e0e0; }
.blog-table tbody tr { transition:background .15s; border-bottom:1px solid #1a1a30; }
.blog-table tbody tr:hover { background:#14142a; }
.blog-table tbody td { padding:13px 16px; vertical-align:middle; }

.bbadge-id      { background:#1e1e2a; color:#818cf8; border-radius:6px; padding:3px 9px; font-size:12px; font-weight:700; }
.bbadge-title   { font-size:13px; font-weight:600; color:#e2e8f0; }
.bbadge-slug    { color:#4b5563; font-size:11px; margin-top:2px; }
.bbadge-author  { background:#1e1e2a; color:#94a3b8; border:1px solid #2a2a3a; border-radius:6px; padding:3px 9px; font-size:12px; }
.bbadge-cat     { background:#1e1e2a; color:#a78bfa; border:1px solid #2e2050; border-radius:6px; padding:3px 9px; font-size:12px; font-weight:600; }

.bbadge-publie    { background:#0d2b1a; color:#4ade80; border:1px solid #1a3d28; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }
.bbadge-brouillon { background:#2e1e06; color:#fbbf24; border:1px solid #4a3010; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }
.bbadge-attente   { background:#0a1a2e; color:#7dd3fc; border:1px solid #0e2a4a; border-radius:20px; padding:3px 10px; font-size:11px; font-weight:700; }

.thumb-wrap {
    width:58px; height:48px; border-radius:8px; overflow:hidden;
    border:1px solid #2a2a3a; background:#1e1e2a;
    display:inline-flex; align-items:center; justify-content:center;
    color:#4b5563; font-size:18px;
}
.thumb-wrap img { width:100%; height:100%; object-fit:cover; display:block; }

.bact { display:flex; gap:6px; align-items:center; flex-wrap:nowrap; }
.bbtn {
    display:inline-flex; align-items:center; gap:4px;
    padding:5px 11px; border-radius:6px; font-size:12px; font-weight:500;
    text-decoration:none; border:1px solid #2a2a3a; cursor:pointer;
    background:#1a1a28; color:#94a3b8;
    transition:color .15s, border-color .15s; white-space:nowrap;
}
.bbtn:hover { color:#e0e0e0; border-color:#444; }
.bbtn-view    { color:#818cf8; border-color:#2e2e50; }
.bbtn-publish { color:#4ade80; border-color:#1a3d28; }
.bbtn-unpub   { color:#fb923c; border-color:#4a2808; }
.bbtn-del     { color:#f87171; border-color:#3d1f1f; }
.bbtn form, .bbtn button {
    margin:0; padding:0; background:none; border:none;
    color:inherit; font:inherit; font-size:12px; font-weight:500;
    cursor:pointer; display:inline;
}
</style>

<div class="page-header">
    <h1>Articles</h1>
    <p>Gérer tous les articles du blog</p>
</div>

{# ===== FILTRES ===== #}
{% set selected_statuses = selected_statuses|default(['all']) %}
{% set selected_categories = selected_categories|default([]) %}
{% set period_filter = period_filter|default('all') %}
{% set sort_filter = sort|default('recent') %}

<div class="card" style="margin-bottom:20px">
    <div class="card-header"><h3 class="card-title">Filtres & Recherche</h3></div>
    <form method="GET" action="{{ path('admin_blogs') }}" id="blogFiltersForm"
          style="display:flex;flex-wrap:wrap;gap:12px;padding:16px;align-items:flex-end">

        <div style="flex:1;min-width:200px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Recherche (titre, auteur)</label>
            <input type="text" name="q" value="{{ search }}" placeholder="Rechercher..."
                   style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
        </div>

        <div style="min-width:150px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Statut</label>
            <select name="statuses[]" style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
                <option value="all"      {{ 'all'       in selected_statuses ? 'selected' : '' }}>Tous</option>
                <option value="published"{{ 'published' in selected_statuses ? 'selected' : '' }}>Publié</option>
                <option value="draft"    {{ 'draft'     in selected_statuses ? 'selected' : '' }}>Brouillon</option>
                <option value="pending"  {{ 'pending'   in selected_statuses ? 'selected' : '' }}>En attente</option>
            </select>
        </div>

        <div style="min-width:160px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Catégorie</label>
            <select name="categories[]" style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
                <option value="">Toutes</option>
                {% for category in available_categories|default([]) %}
                    <option value="{{ category }}" {{ category in selected_categories ? 'selected' : '' }}>{{ category }}</option>
                {% endfor %}
            </select>
        </div>

        <div style="min-width:140px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Période</label>
            <select name="period" style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
                <option value="all"   {{ period_filter == 'all'   ? 'selected' : '' }}>Tout</option>
                <option value="today" {{ period_filter == 'today' ? 'selected' : '' }}>Aujourd'hui</option>
                <option value="week"  {{ period_filter == 'week'  ? 'selected' : '' }}>Cette semaine</option>
                <option value="month" {{ period_filter == 'month' ? 'selected' : '' }}>Ce mois</option>
            </select>
        </div>

        <div style="min-width:150px">
            <label style="display:block;font-size:12px;margin-bottom:4px;color:#888">Trier par</label>
            <select name="sort" style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #333;background:#1a1a2e;color:#fff;font-size:13px">
                <option value="recent"     {{ sort_filter == 'recent'      ? 'selected' : '' }}>Plus récent</option>
                <option value="oldest"     {{ sort_filter == 'oldest'      ? 'selected' : '' }}>Plus ancien</option>
                <option value="most_viewed"{{ sort_filter == 'most_viewed' ? 'selected' : '' }}>Plus vu</option>
                <option value="alpha"      {{ sort_filter == 'alpha'       ? 'selected' : '' }}>Alphabétique</option>
            </select>
        </div>

        <div style="display:flex;gap:8px">
            <button type="submit" style="padding:8px 18px;border-radius:6px;border:none;background:#6c63ff;color:#fff;font-size:13px;cursor:pointer;font-weight:600">🔍 Filtrer</button>
            <a href="{{ path('admin_blogs') }}" style="padding:8px 18px;border-radius:6px;border:1px solid #555;color:#aaa;font-size:13px;text-decoration:none;display:flex;align-items:center">✕ Reset</a>
        </div>
    </form>
</div>

{# ===== FLASH MESSAGES ===== #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set msg = message %}
        {% if message == 'Blog published successfully.' %}{% set msg = 'Article publié avec succès' %}
        {% elseif message == 'Blog deleted successfully.' %}{% set msg = 'Article supprimé' %}
        {% elseif message == 'Blog moved back to draft.' %}{% set msg = 'Modifications enregistrées' %}{% endif %}
        <div style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:#0d2b1a;color:#4ade80;border:1px solid #1a3d28;font-size:13px;font-weight:600;">✅ {{ msg }}</div>
    {% endfor %}
{% endfor %}

{# ===== TABLEAU ===== #}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            Liste des Articles
            <span style="font-size:13px;color:#888;font-weight:normal;margin-left:8px">
                ({{ blogs|length }} résultat{{ blogs|length > 1 ? 's' : '' }})
            </span>
        </h3>
        <div style="display:flex;gap:8px">
            <button onclick="openStatsPopup()" style="padding:8px 16px;border-radius:6px;border:none;background:#6c63ff;color:#fff;font-size:13px;font-weight:600;cursor:pointer">📊 Statistiques</button>
        </div>
    </div>

    {% if blogs is empty %}
        <div style="padding:40px;text-align:center;color:#4b5563;font-size:14px">Aucun article ne correspond à votre recherche.</div>
    {% else %}
    <div style="overflow-x:auto">
    <table class="blog-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Titre</th>
                <th>Auteur</th>
                <th>Catégorie</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for blog in blogs %}
                {% set metrics = blog_metrics[blog.id] ?? {} %}
                {% set cover = metrics.cover_image|default(blog.imageCouverture ?: '') %}
                {% set statusLabel = blog.status ? 'Publié' : 'Brouillon' %}
                {% set statusClass = blog.status ? 'bbadge-publie' : 'bbadge-brouillon' %}
                {% if blog.publicationRequested is defined and blog.publicationRequested and not blog.status %}
                    {% set statusLabel = 'En attente' %}
                    {% set statusClass = 'bbadge-attente' %}
                {% endif %}
            <tr>
                <td><span class="bbadge-id">#{{ blog.id }}</span></td>
                <td>
                    <div class="thumb-wrap">
                        {% if cover %}
                            <img src="{{ cover }}" alt="{{ blog.titre }}" loading="lazy">
                        {% else %}
                            🖼
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div class="bbadge-title">{{ blog.titre }}</div>
                    <div class="bbadge-slug">{{ blog.slug ?: '—' }}</div>
                </td>
                <td><span class="bbadge-author">{{ blog.authorId ?: 'Utilisateur' }}</span></td>
                <td><span class="bbadge-cat">{{ metrics.category|default('Non catégorisé') }}</span></td>
                <td><span style="font-size:12px;color:#94a3b8">{{ blog.datePublication ? blog.datePublication|date('d/m/Y') : (blog.dateCreation ? blog.dateCreation|date('d/m/Y') : '—') }}</span></td>
                <td><span class="{{ statusClass }}">{{ statusLabel }}</span></td>
                <td>
                    <div class="bact">
                        <a href="{{ path('admin_blog_show', {'id': blog.id}) }}" class="bbtn bbtn-view">👁 Voir</a>
                        <span class="bbtn {{ blog.status ? 'bbtn-unpub' : 'bbtn-publish' }}">
                            <form method="post" action="{{ path('admin_blog_workflow', {'id': blog.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_workflow_blog_' ~ blog.id) }}">
                                <input type="hidden" name="action" value="{{ blog.status ? 'draft' : 'publish' }}">
                                <button type="submit">{{ blog.status ? '⏸ Dépublier' : '✅ Publier' }}</button>
                            </form>
                        </span>
                        <span class="bbtn bbtn-del">
                            <form method="post" action="{{ path('admin_blog_delete', {'id': blog.id}) }}" onsubmit="return confirm('Supprimer cet article ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_blog_' ~ blog.id) }}">
                                <button type="submit">🗑 Supprimer</button>
                            </form>
                        </span>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}
</div>

{# ===== POPUP STATISTIQUES ===== #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<div id="stats-popup" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.8);backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding:20px;overflow-y:auto">
    <div style="background:#1a1a2e;border:1px solid #3a3a4a;border-radius:20px;width:100%;max-width:1000px;margin:auto;box-shadow:0 30px 80px rgba(0,0,0,.8)">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 28px;border-bottom:1px solid #3a3a4a">
            <h3 style="margin:0;color:#fff;font-size:18px;font-weight:700">📊 Statistiques des Articles</h3>
            <button onclick="closeStatsPopup()" style="width:36px;height:36px;border-radius:50%;border:1px solid #555;background:none;color:#aaa;font-size:18px;cursor:pointer">✕</button>
        </div>
        <div style="padding:28px">
            {# Cartes résumé #}
            {% set vues_totales = 0 %}
            {% for item in blog_metrics %}
                {% set vues_totales = vues_totales + (item.views|default(0)) %}
            {% endfor %}
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px">
                <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a;text-align:center">
                    <div style="font-size:28px;font-weight:800;color:#f97316">{{ stats.total }}</div>
                    <div style="font-size:12px;color:#888;margin-top:6px">Total articles</div>
                </div>
                <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a;text-align:center">
                    <div style="font-size:28px;font-weight:800;color:#4ade80">{{ stats.published }}</div>
                    <div style="font-size:12px;color:#888;margin-top:6px">Publiés</div>
                </div>
                <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a;text-align:center">
                    <div style="font-size:28px;font-weight:800;color:#fbbf24">{{ stats.drafts }}</div>
                    <div style="font-size:12px;color:#888;margin-top:6px">Brouillons</div>
                </div>
                <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a;text-align:center">
                    <div style="font-size:28px;font-weight:800;color:#3b82f6">{{ vues_totales }}</div>
                    <div style="font-size:12px;color:#888;margin-top:6px">👁 Vues totales</div>
                </div>
            </div>

            {# Graphiques #}
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
                <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a">
                    <h5 style="margin:0 0 16px;color:#fff;font-size:14px;font-weight:600;border-left:3px solid #f97316;padding-left:10px">Répartition par statut</h5>
                    <canvas id="chartStatut" height="200"></canvas>
                </div>
                <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a">
                    <h5 style="margin:0 0 16px;color:#fff;font-size:14px;font-weight:600;border-left:3px solid #6c63ff;padding-left:10px">Articles par catégorie</h5>
                    <canvas id="chartCategories" height="200"></canvas>
                </div>
            </div>

            {# Tableau #}
            <div style="background:#12122a;border-radius:12px;padding:20px;border:1px solid #2a2a4a">
                <h5 style="margin:0 0 16px;color:#fff;font-size:14px;font-weight:600;border-left:3px solid #3b82f6;padding-left:10px">Articles récents</h5>
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead>
                        <tr style="border-bottom:1px solid #2a2a4a">
                            <th style="padding:10px;text-align:left;color:#888;font-weight:600">#</th>
                            <th style="padding:10px;text-align:left;color:#888;font-weight:600">Titre</th>
                            <th style="padding:10px;text-align:left;color:#888;font-weight:600">Catégorie</th>
                            <th style="padding:10px;text-align:left;color:#888;font-weight:600">Date</th>
                            <th style="padding:10px;text-align:left;color:#888;font-weight:600">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for blog in blogs|slice(0,5) %}
                        {% set metrics = blog_metrics[blog.id] ?? {} %}
                        <tr style="border-bottom:1px solid #2a2a4a">
                            <td style="padding:10px;color:#f97316;font-weight:700">{{ loop.index }}</td>
                            <td style="padding:10px;color:#fff;font-weight:600">{{ blog.titre }}</td>
                            <td style="padding:10px;color:#a78bfa">{{ metrics.category|default('—') }}</td>
                            <td style="padding:10px;color:#888">{{ blog.datePublication ? blog.datePublication|date('d/m/Y') : '—' }}</td>
                            <td style="padding:10px">
                                <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:{{ blog.status ? '#0d2b1a' : '#2e1e06' }};color:{{ blog.status ? '#4ade80' : '#fbbf24' }}">
                                    {{ blog.status ? 'Publié' : 'Brouillon' }}
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
function openStatsPopup() {
    document.getElementById('stats-popup').style.display = 'flex';
    renderBlogCharts();
}
function closeStatsPopup() {
    document.getElementById('stats-popup').style.display = 'none';
}
document.getElementById('stats-popup').addEventListener('click', function(e) { if (e.target === this) closeStatsPopup(); });

var blogChartsDrawn = false;
function renderBlogCharts() {
    if (blogChartsDrawn) return;
    blogChartsDrawn = true;
    Chart.defaults.color = '#888';

    new Chart(document.getElementById('chartStatut'), {
        type: 'pie',
        data: {
            labels: ['Publiés', 'Brouillons'],
            datasets: [{ data: [{{ stats.published }}, {{ stats.drafts }}],
                backgroundColor: ['#4ade80','#fbbf24'], borderColor: '#1a1a2e', borderWidth: 3 }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { color: '#888', padding: 12 } } } }
    });

    var catLabels = [];
    var catData   = [];
    {% for category in available_categories|default([]) %}
        catLabels.push('{{ category }}');
        catData.push({{ blogs|filter(b => (blog_metrics[b.id] ?? {}).category|default('') == category)|length }});
    {% endfor %}

    new Chart(document.getElementById('chartCategories'), {
        type: 'bar',
        data: {
            labels: catLabels,
            datasets: [{ label: 'Articles', data: catData,
                backgroundColor: '#6c63ff', borderRadius: 6, borderSkipped: false }]
        },
        options: { responsive: true, plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1, color: '#888' }, grid: { color: '#2a2a4a' } },
                      x: { grid: { display: false }, ticks: { color: '#ccc' } } } }
    });
}
</script>

<footer class="copyright">Copyright &copy; 2026 VoyageLoisir</footer>
{% endblock %}
