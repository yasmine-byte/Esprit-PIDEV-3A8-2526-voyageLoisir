{% extends 'base_front.html.twig' %}
{% block title %}Contact – ViaNoVa{% endblock %}

{% block body %}
<style>
@keyframes fadeInUp { from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);} }
.contact-page { background:linear-gradient(135deg,#fff8f4 0%,#fef0e8 50%,#f8f9fa 100%); min-height:100vh; padding:0 0 70px; }
.contact-hero { background:linear-gradient(135deg,#d4845a,#e8a87c 60%,#f5c99a); padding:60px 0 100px; position:relative; overflow:hidden; text-align:center; }
.contact-hero::before { content:''; position:absolute; top:-40px; right:-60px; width:300px; height:300px; border-radius:50%; background:rgba(255,255,255,0.08); }
.contact-hero::after  { content:''; position:absolute; bottom:-60px; left:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,0.06); }
.contact-hero h1 { color:#fff; font-size:2.4rem; font-weight:800; margin:0 0 10px; position:relative; z-index:1; }
.contact-hero p  { color:rgba(255,255,255,0.85); font-size:1rem; margin:0; position:relative; z-index:1; }
.contact-card { background:#fff; border-radius:24px; box-shadow:0 20px 60px rgba(212,132,90,0.13); padding:44px 48px; margin-top:-60px; position:relative; z-index:10; animation:fadeInUp 0.6s ease forwards; max-width: 600px; margin-left: auto; margin-right: auto; }
.contact-card-top { position:absolute; top:0; left:0; right:0; height:5px; border-radius:24px 24px 0 0; background:linear-gradient(90deg,#d4845a,#e8a87c,#f5c99a); }
.contact-grid { display:block; }
.info-block h3 { font-size:1.1rem; font-weight:800; color:#333; margin-bottom:20px; }
.info-item { display:flex; align-items:flex-start; gap:14px; margin-bottom:20px; }
.info-icon { width:42px; height:42px; border-radius:12px; background:linear-gradient(135deg,#fff3eb,#ffe9d5); border:1.5px solid #f5cba7; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.info-label { font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:#bbb; margin-bottom:3px; }
.info-value { font-size:0.95rem; font-weight:600; color:#333; }
.form-block h3 { font-size:1.1rem; font-weight:800; color:#333; margin-bottom:20px; }
.f-group { margin-bottom:18px; }
.f-label { display:block; font-size:0.78rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:#555; margin-bottom:8px; }
.f-input { width:100%; padding:12px 16px; border:2px solid #eee; border-radius:12px; font-size:0.92rem; color:#333; background:#fafafa; box-sizing:border-box; transition:border-color 0.25s,box-shadow 0.25s; font-family:inherit; }
.f-input:focus { outline:none; border-color:#d4845a; box-shadow:0 0 0 4px rgba(212,132,90,0.1); background:#fff; }
.f-textarea { resize:vertical; min-height:130px; }
.btn-send { width:100%; padding:14px; background:linear-gradient(135deg,#d4845a,#e8a87c); color:#fff; border:none; border-radius:12px; font-size:1rem; font-weight:800; cursor:pointer; transition:all 0.25s; box-shadow:0 8px 24px rgba(212,132,90,0.3); font-family:inherit; }
.btn-send:hover { transform:translateY(-2px); box-shadow:0 12px 32px rgba(212,132,90,0.4); }
.divider { height:2px; background:linear-gradient(90deg,#f5cba7,transparent); border-radius:2px; margin:32px 0; }
@media(max-width:768px) { .contact-grid{grid-template-columns:1fr;} .contact-card{padding:28px 20px;} }
</style>

<div class="contact-page">
    <div class="contact-hero">
        <div class="container">
            <div style="font-size:3rem; margin-bottom:12px;">✉️</div>
            <h1>Contactez-nous</h1>
            <p>Notre équipe est disponible pour répondre à toutes vos questions.</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="contact-card">
                    <div class="contact-card-top"></div>

                    <div class="contact-grid">

                        {# ── Infos de contact ── #}
