<style>
/* Force une seule ligne et style pro */
.navbar { 
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: nowrap !important; 
    padding: 0 55px;
}
.navbar-collapse { 
    display: flex !important; 
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: nowrap !important; 
    width: 100%;
}
.navbar-nav { 
    display: flex !important; 
    flex-direction: row !important; 
    align-items: center !important;
    flex-wrap: nowrap !important; 
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
}
.nav-item, .nav-item a { 
    white-space: nowrap !important; 
}

/* Ajustement pour le logo */
.logo {
    margin-right: 30px;
}
</style>

<header class="header-area header-sticky" style="width: 100%;">
        <nav style="display:flex; align-items:center; justify-content:space-between;
                    width:100%; padding:0 60px; height:70px;
                    background:#fff; box-shadow:0 2px 8px rgba(0,0,0,0.06);
                    box-sizing:border-box; position:relative;">

            <!-- 1. Logo à gauche -->
            <a href="{{ path('app_home') }}"
               style="font-size:25px; font-weight:900; color:#111;
                      text-decoration:none; letter-spacing:2px; flex-shrink:0; z-index:1;">
                VIANOVA
            </a>

            <!-- 2. Liens au CENTRE absolu -->
            <div style="position:absolute; left:50%; transform:translateX(-50%);
                        display:flex; align-items:center; gap:4px;">
                <a href="{{ path('app_home') }}"
                   style="padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">Home</a>

                <a href="{{ path('app_destinations') }}"
                   style="padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">Destination</a>

                <a href="{{ path('app_hebergements_front') }}"
                   style="padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">Hébergement</a>

                <a href="{{ path('app_activite_index') }}"
                   style="padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">Activité</a>

                <a href="{{ path('avis_index') }}"
                   style="display:inline-flex; align-items:center; gap:4px;
                          padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    Avis
                </a>

                <a href="{{ path('app_blog_index') }}"
                   style="padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">Blog</a>

                <a href="{{ path('app_contact') }}"
                   style="display:inline-flex; align-items:center; gap:4px;
                          padding:8px 18px; font-size:20px; font-weight:600;
                          color:#333; text-decoration:none; white-space:nowrap;
                          border-radius:8px; transition:color 0.2s;"
                   onmouseover="this.style.color='#d4845a'"
                   onmouseout="this.style.color='#333'">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,12 2,6"/>
                    </svg>
                    Contact
                </a>
            </div>

            <!-- 3. Droite : Mon Espace + Nom + Déconnexion -->
            <div style="display:flex; align-items:center; gap:12px;
                        flex-shrink:0; flex-wrap:nowrap; z-index:1;">

                {% if app.user %}
                <!-- Mon Espace -->
                <a href="{{ path('front_profile') }}"
                   style="display:inline-flex; align-items:center; gap:6px;
                          padding:7px 14px; border-radius:8px;
                          background:#fff3eb; border:1.5px solid #f5cba7;
                          color:#d4845a; font-size:19px; font-weight:700;
                          text-decoration:none; white-space:nowrap; flex-shrink:0;
                          transition:all 0.2s;"
                   onmouseover="this.style.background='#fde9d4';this.style.borderColor='#d4845a'"
                   onmouseout="this.style.background='#fff3eb';this.style.borderColor='#f5cba7'">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="#d4845a" stroke-width="2.5">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Mon Espace
                </a>

                <!-- Avatar + Nom -->
                <div style="display:inline-flex; align-items:center; gap:7px; flex-shrink:0;">
                    <div style="width:32px; height:32px; border-radius:50%;
                                background:linear-gradient(135deg,#d4845a,#e8a87c);
                                display:flex; align-items:center; justify-content:center;
                                color:#fff; font-size:16px; font-weight:800; flex-shrink:0;">
                        {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                    </div>
                    <span style="font-size:14px; font-weight:600; color:#333; white-space:nowrap;">
                        {{ app.user.prenom }} {{ app.user.nom }}
                    </span>
                </div>

                <!-- Déconnexion -->
                <form method="post" action="{{ path('front_logout') }}" style="margin:0;display:inline-flex;">
                    <button type="submit"
                            title="Se déconnecter"
                            style="display:inline-flex; align-items:center; justify-content:center;
                                   width:34px; height:34px; border-radius:8px;
                                   background:#fff0f0; border:1.5px solid #fecaca;
                                   color:#dc2626; cursor:pointer; transition:all 0.2s;
                                   flex-shrink:0; padding:0;"
                            onmouseover="this.style.background='#fee2e2';this.style.borderColor='#dc2626';this.style.transform='translateY(-1px)'"
                            onmouseout="this.style.background='#fff0f0';this.style.borderColor='#fecaca';this.style.transform='translateY(0)'">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="#dc2626" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
                {% else %}
                <a href="http://127.0.0.1:8000/admin/login"
                   style="background:#1a1a1a; color:#fff; padding:10px 22px; border-radius:30px; font-weight:600; font-size:13px; text-decoration:none; transition:all 0.2s;"
                   onmouseover="this.style.background='#f97316'"
                   onmouseout="this.style.background='#1a1a1a'">
                  Login
                </a>
                {% endif %}

            </div>

        </nav>
</header>

{% if not app.user %}
<div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:16px;border:none">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body px-4 pb-4">
        <div class="text-center mb-3">
          <h3 style="color:#d4845a;font-weight:700">ViaNoVa</h3>
          <p class="text-muted" style="font-size:14px">Bienvenue sur votre plateforme de voyage</p>
        </div>
        <ul class="nav nav-pills mb-4" style="background:#f8f9fa;border-radius:10px;padding:4px;gap:4px">
          <li class="nav-item flex-fill">
            <button class="nav-link active w-100" data-bs-toggle="pill" data-bs-target="#signIn">Se connecter</button>
          </li>
          <li class="nav-item flex-fill">
            <button class="nav-link w-100" data-bs-toggle="pill" data-bs-target="#signUp">S'inscrire</button>
          </li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane fade show active" id="signIn">
            <form method="POST" action="{{ path('front_login_check') }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('front_authenticate') }}">
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="_username" class="form-control" placeholder="votre@email.com" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Mot de passe</label>
                <input type="password" name="_password" class="form-control" placeholder="Mot de passe" required>
              </div>
              <button type="submit" class="btn w-100" style="background:linear-gradient(135deg,#e8a87c,#d4845a);color:#fff;border:none;border-radius:8px;padding:12px;font-weight:600">
                Se connecter
              </button>
            </form>

            {# ===== BOUTON CONNEXION FACIALE ===== #}
            <div style="text-align:center; margin-top:16px;">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                <hr style="flex:1; border-color:#eee;">
                <span style="color:#aaa; font-size:12px;">ou</span>
                <hr style="flex:1; border-color:#eee;">
              </div>
              <a href="{{ path('face_login_page') }}"
                 style="display:flex; align-items:center; justify-content:center; gap:8px; width:100%; padding:12px; background:#f8f9fa; border:1.5px solid #e0e0e0; border-radius:8px; color:#333; font-size:14px; font-weight:600; text-decoration:none; transition:all 0.2s;"
                 onmouseover="this.style.background='#fff3f0'; this.style.borderColor='#f75959'; this.style.color='#f75959';"
                 onmouseout="this.style.background='#f8f9fa'; this.style.borderColor='#e0e0e0'; this.style.color='#333';">
                📷 Se connecter avec mon visage
              </a>
            </div>

          </div>
          <div class="tab-pane fade" id="signUp">
            <form method="POST" action="{{ path('front_register') }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('front_register') }}">
              <div class="row">
                <div class="col-6 mb-3">
                  <label class="form-label">Nom</label>
                  <input type="text" name="nom" class="form-control" placeholder="Votre nom" required>
                </div>
                <div class="col-6 mb-3">
                  <label class="form-label">Prénom</label>
                  <input type="text" name="prenom" class="form-control" placeholder="Votre prénom" required>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="votre@email.com" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Mot de passe</label>
                <input type="password" name="password" class="form-control" placeholder="Minimum 8 caractères" required minlength="8">
              </div>
              <div class="mb-3">
                <label class="form-label">Confirmer le mot de passe</label>
                <input type="password" name="confirm_password" class="form-control" placeholder="Répétez le mot de passe" required>
              </div>
              <button type="submit" class="btn w-100" style="background:linear-gradient(135deg,#e8a87c,#d4845a);color:#fff;border:none;border-radius:8px;padding:12px;font-weight:600">
                Créer mon compte
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
