{% extends 'base_front.html.twig' %}
{% block title %}Nouvelle Réclamation – ViaNoVa{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
@keyframes fadeInUp { from{opacity:0;transform:translateY(28px);}to{opacity:1;transform:translateY(0);} }
@keyframes pulse { 0%,100%{transform:scale(1);}50%{transform:scale(1.06);} }
@keyframes spin { from{transform:rotate(0deg);}to{transform:rotate(360deg);} }
.recl-page-wrap { background:linear-gradient(135deg,#fff8f4 0%,#fef0e8 50%,#f8f9fa 100%); min-height:100vh; padding:0 0 60px; }
.recl-hero { background:linear-gradient(135deg,#d4845a 0%,#e8a87c 60%,#f5c99a 100%); padding:50px 0 90px; position:relative; overflow:hidden; }
.recl-hero::before { content:''; position:absolute; top:-40px; right:-60px; width:320px; height:320px; border-radius:50%; background:rgba(255,255,255,0.08); pointer-events:none; }
.recl-hero::after  { content:''; position:absolute; bottom:-60px; left:-40px; width:220px; height:220px; border-radius:50%; background:rgba(255,255,255,0.06); pointer-events:none; }
.recl-hero-icon { font-size:52px; margin-bottom:14px; animation:pulse 2.5s ease infinite; }
.recl-hero h2 { color:#fff; font-size:2rem; font-weight:800; margin:0 0 6px; }
.recl-hero p  { color:rgba(255,255,255,0.82); font-size:1rem; margin:0; }
.recl-breadcrumb a { color:rgba(255,255,255,0.75); font-size:0.85rem; text-decoration:none; }
.recl-breadcrumb span { color:rgba(255,255,255,0.5); margin:0 6px; }
.recl-card { background:#fff; border-radius:24px; box-shadow:0 20px 60px rgba(212,132,90,0.13),0 4px 20px rgba(0,0,0,0.05); padding:44px 48px; margin-top:-55px; position:relative; z-index:10; animation:fadeInUp 0.65s ease forwards; }
.recl-card-border-top { position:absolute; top:0; left:0; right:0; height:5px; border-radius:24px 24px 0 0; background:linear-gradient(90deg,#d4845a,#e8a87c,#f5c99a); }
.step-label { display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg,#fff3eb,#ffe9d5); border:1px solid #f5cba7; border-radius:30px; padding:5px 16px; font-size:0.8rem; font-weight:700; color:#d4845a; margin-bottom:28px; }
.field-block { margin-bottom:26px; }
.field-label { display:block; font-size:0.82rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:#555; margin-bottom:9px; }
.field-input { width:100%; padding:13px 16px 13px 46px; border:2px solid #eee; border-radius:14px; font-size:0.95rem; color:#333; transition:border-color 0.25s,box-shadow 0.25s; box-sizing:border-box; background:#fafafa; }
.field-input:focus { outline:none; border-color:#d4845a; box-shadow:0 0 0 4px rgba(212,132,90,0.12); background:#fff; }
.field-input.valid   { border-color:#22c55e; background:#f0fdf4; }
.field-input.invalid { border-color:#ef4444; background:#fef2f2; }
.field-input-wrap { position:relative; }
.field-icon { position:absolute; left:15px; top:50%; transform:translateY(-50%); font-size:16px; pointer-events:none; }
.field-select { width:100%; padding:13px 42px 13px 16px; border:2px solid #eee; border-radius:14px; font-size:0.95rem; color:#333; background:#fafafa url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' fill='%23d4845a' viewBox='0 0 16 16'><path fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/></svg>") no-repeat right 16px center; appearance:none; transition:border-color 0.25s; box-sizing:border-box; }
.field-select:focus { outline:none; border-color:#d4845a; box-shadow:0 0 0 4px rgba(212,132,90,0.12); background-color:#fff; }
.field-hint  { font-size:0.78rem; color:#aaa; margin-top:5px; }
.field-error { font-size:0.78rem; color:#ef4444; margin-top:4px; font-weight:600; }
.prio-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:4px; }
.prio-btn { border:2px solid #eee; border-radius:14px; padding:13px 6px; text-align:center; cursor:pointer; transition:all 0.22s; font-weight:700; font-size:0.82rem; color:#aaa; background:#fafafa; user-select:none; }
.prio-btn:hover { transform:translateY(-3px); box-shadow:0 6px 16px rgba(0,0,0,0.08); }
.prio-btn.sel-basse   { background:#f0fdf4; border-color:#22c55e; color:#16a34a; }
.prio-btn.sel-moyenne { background:#eff6ff; border-color:#3b82f6; color:#1d4ed8; }
.prio-btn.sel-haute   { background:#fff7ed; border-color:#f97316; color:#c2410c; }
.prio-btn.sel-urgente { background:#fef2f2; border-color:#ef4444; color:#dc2626; }
.hidden-field { display:none !important; }
.quality-wrap { margin-top:8px; }
.quality-bar  { height:5px; background:#eee; border-radius:4px; overflow:hidden; }
.quality-fill { height:100%; width:0; border-radius:4px; transition:width 0.3s,background 0.3s; }
.quality-meta { display:flex; justify-content:space-between; font-size:0.78rem; font-weight:600; margin-top:4px; }
.btn-ia { display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; border:none; border-radius:30px; padding:10px 22px; font-size:0.85rem; font-weight:700; cursor:pointer; transition:all 0.25s; box-shadow:0 4px 14px rgba(102,126,234,0.3); }
.btn-ia:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(102,126,234,0.4); }
.ia-result { display:none; margin-top:14px; padding:14px 18px; border-radius:14px; background:linear-gradient(135deg,#f5f3ff,#ede9fe); border:1px solid #c4b5fd; font-size:0.88rem; color:#5b21b6; }
.btn-send { background:linear-gradient(135deg,#d4845a,#e8a87c); color:#fff; border:none; border-radius:50px; padding:14px 40px; font-size:1rem; font-weight:800; cursor:pointer; transition:all 0.25s; display:inline-flex; align-items:center; gap:10px; box-shadow:0 8px 24px rgba(212,132,90,0.35); }
.btn-send:hover { transform:translateY(-2px); box-shadow:0 12px 32px rgba(212,132,90,0.45); }
.btn-send .spin-icon { display:none; animation:spin 1s linear infinite; }
.btn-send.loading .send-label { display:none; }
.btn-send.loading .spin-icon  { display:inline-block; }
.btn-back-link { background:#fff; color:#888; border:2px solid #e8e8e8; border-radius:50px; padding:14px 36px; font-size:0.95rem; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:8px; transition:all 0.22s; }
.btn-back-link:hover { background:#f5f5f5; border-color:#ccc; color:#444; text-decoration:none; }
@media(max-width:768px) { .prio-grid{grid-template-columns:repeat(2,1fr);} .recl-card{padding:28px 20px;} }
.linked-box { display:none; margin-top:12px; border-radius:16px; overflow:hidden; background:#fff; box-shadow:0 4px 20px rgba(212,132,90,0.12); border:1.5px solid #f5cba7; }
.linked-box.show { display:block; animation:fadeInUp 0.3s ease; }
.linked-box-header { background:linear-gradient(135deg,#fff3eb,#ffe9d5); padding:13px 20px; font-size:0.78rem; font-weight:800; text-transform:uppercase; letter-spacing:0.07em; color:#d4845a; border-bottom:1.5px solid #f5cba7; display:flex; align-items:center; gap:8px; }
.linked-box-body { padding:14px 16px; }
.linked-select {
    width:100%;
    padding:13px 42px 13px 16px;
    border:2px solid #eee;
    border-radius:14px;
    font-size:0.92rem;
    color:#333;
    background:#fafafa url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' fill='%23d4845a' viewBox='0 0 16 16'><path fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/></svg>") no-repeat right 16px center;
    appearance:none;
    transition:border-color 0.25s, box-shadow 0.25s;
    box-sizing:border-box;
    cursor:pointer;
}
.linked-select:focus { outline:none; border-color:#d4845a; box-shadow:0 0 0 4px rgba(212,132,90,0.12); background-color:#fff; }
.linked-hint { font-size:0.75rem; color:#aaa; margin-top:7px; display:flex; align-items:center; gap:5px; }
</style>
{% endblock %}

{% block body %}
<div class="recl-page-wrap">
    <div class="recl-hero">
        <div class="container text-center">
            <div class="recl-breadcrumb mb-3">
                <a href="{{ path('front_profile') }}">Mon Profil</a>
                <span>›</span>
                <span style="color:rgba(255,255,255,0.85)">Nouvelle Réclamation</span>
            </div>
            <div class="recl-hero-icon">📝</div>
            <h2>Soumettre une Réclamation</h2>
            <p>Décrivez votre problème, notre équipe vous répond rapidement.</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-8">
                <div class="recl-card">
                    <div class="recl-card-border-top"></div>
                    <div class="step-label">✍️ Remplissez le formulaire ci-dessous</div>

                    {{ form_start(form, {'attr': {'novalidate':'novalidate','id':'form-recl'}}) }}

                    <div class="field-block">
                        <label class="field-label">📌 Titre de la réclamation</label>
                        <div class="field-input-wrap">
                            <span class="field-icon">✏️</span>
                            {{ form_widget(form.titre, {'attr':{'class':'field-input','placeholder':'Ex: Problème de réservation, service incorrect…','id':'inp-titre'}}) }}
                        </div>
                        <div class="field-hint" id="hint-titre">Minimum 5 caractères.</div>
                        <div class="field-error">{{ form_errors(form.titre) }}</div>
                    </div>

                    <div class="field-block">
                        <label class="field-label">🏷 Catégorie du problème</label>
                        {{ form_widget(form.type, {'attr':{'class':'field-select', 'id':'recl-type-select'}}) }}
                        <div class="field-error">{{ form_errors(form.type) }}</div>

                        {# ── Box réservation ── #}
                        <div class="linked-box" id="box-reservation">
                            <div class="linked-box-header">
                                🏨 Sélectionnez votre réservation concernée
                            </div>
                            <div class="linked-box-body">
                                {{ form_widget(form.reservation, {'attr': {
                                    'class': 'linked-select'
                                }}) }}
                                <div class="linked-hint">
                                    ℹ️ Seules vos réservations personnelles sont affichées.
                                </div>
                                <div class="field-error">{{ form_errors(form.reservation) }}</div>
                            </div>
                        </div>

                        {# ── Box activité ── #}
                        <div class="linked-box" id="box-activite">
                            <div class="linked-box-header">
                                🎯 Sélectionnez votre activité concernée
                            </div>
                            <div class="linked-box-body">
                                {{ form_widget(form.reservationActivite, {'attr': {
                                    'class': 'linked-select'
                                }}) }}
                                <div class="linked-hint">
                                    ℹ️ Seules vos activités personnelles sont affichées.
                                </div>
                                <div class="field-error">{{ form_errors(form.reservationActivite) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="field-block">
                        <label class="field-label">🎯 Niveau de priorité</label>
                        <div class="prio-grid">
                            <div class="prio-btn" data-val="Basse">🟢<br>Basse</div>
                            <div class="prio-btn" data-val="Moyenne">🔵<br>Moyenne</div>
                            <div class="prio-btn" data-val="Haute">🟠<br>Haute</div>
                            <div class="prio-btn" data-val="Urgente">🔴<br>Urgente</div>
                        </div>
                        <div class="hidden-field">{{ form_widget(form.priorite, {'id':'hidden-prio'}) }}</div>
                        <div class="field-error">{{ form_errors(form.priorite) }}</div>
                    </div>

                    <div class="field-block">
                        <label class="field-label">📄 Détails du problème</label>
                        {{ form_widget(form.contenu, {'attr':{'class':'field-input','style':'padding-left:16px;resize:none;min-height:140px;','rows':6,'placeholder':'Décrivez votre problème avec précision… Plus vous donnez de détails, mieux nous pouvons vous aider. 🙏','id':'inp-desc'}}) }}
                        <div class="quality-wrap">
                            <div class="quality-meta">
                                <span id="char-count" style="color:#aaa">0 caractères</span>
                                <span id="quality-label" style="color:#ef4444;font-weight:700;">Trop court</span>
                            </div>
                            <div class="quality-bar"><div class="quality-fill" id="quality-fill"></div></div>
                        </div>
                        <div class="field-error">{{ form_errors(form.contenu) }}</div>
                    </div>

                    <div class="field-block">
                        <button type="button" class="btn-ia" onclick="suggestIA()">🤖 Suggérer la priorité avec l'IA</button>
                        <div class="ia-result" id="ia-result"></div>
                    </div>

                    <div style="display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:32px;">
                        <button type="submit" class="btn-send" id="btn-send">
                            <span class="send-label">🚀 Envoyer ma réclamation</span>
                            <span class="spin-icon">⏳</span>
                        </button>
                        <a href="{{ path('front_profile') }}" class="btn-back-link">✕ Annuler</a>
                    </div>

                    <div class="hidden-field">{{ form_rest(form) }}</div>
                    {{ form_end(form, {'render_rest':false}) }}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const inpTitre = document.getElementById('inp-titre');
    const hintTitre = document.getElementById('hint-titre');
    if (inpTitre) {
        inpTitre.addEventListener('input', function () {
            const v = this.value.trim();
            if (!v) { this.className='field-input'; hintTitre.textContent='Minimum 5 caractères.'; hintTitre.style.color='#aaa'; }
            else if (v.length < 5) { this.className='field-input invalid'; hintTitre.textContent='Trop court (min. 5 caractères).'; hintTitre.style.color='#ef4444'; }
            else { this.className='field-input valid'; hintTitre.textContent='Titre valide ✓'; hintTitre.style.color='#22c55e'; }
        });
    }
    const inpDesc = document.getElementById('inp-desc');
    const ccEl = document.getElementById('char-count');
    const qFill = document.getElementById('quality-fill');
    const qLabel = document.getElementById('quality-label');
    if (inpDesc) {
        inpDesc.addEventListener('input', function () {
            const l = this.value.length;
            ccEl.textContent = l + ' caractères';
            qFill.style.width = Math.min((l/200)*100,100)+'%';
            if (l<50)       { qFill.style.background='#ef4444'; qLabel.textContent='Trop court';      qLabel.style.color='#ef4444'; }
            else if (l<150) { qFill.style.background='#f97316'; qLabel.textContent='Acceptable';     qLabel.style.color='#f97316'; }
            else             { qFill.style.background='#22c55e'; qLabel.textContent='Très détaillé ✓'; qLabel.style.color='#22c55e'; }
        });
    }
    const hiddenPrio = document.getElementById('hidden-prio');
    document.querySelectorAll('.prio-btn').forEach(function (btn) {
        if (hiddenPrio && hiddenPrio.value === btn.dataset.val) btn.classList.add('sel-'+btn.dataset.val.toLowerCase());
        btn.addEventListener('click', function () {
            document.querySelectorAll('.prio-btn').forEach(b => b.className='prio-btn');
            this.classList.add('sel-'+this.dataset.val.toLowerCase());
            if (hiddenPrio) hiddenPrio.value = this.dataset.val;
        });
    });
    const formEl = document.getElementById('form-recl');
    const btnSend = document.getElementById('btn-send');
    if (formEl) formEl.addEventListener('submit', function () { btnSend.classList.add('loading'); });

    (function() {
        var sel = document.getElementById('recl-type-select');
        if (!sel) {
            // Fallback : chercher le select de type
            sel = document.querySelector('select[name*="[type]"]');
        }
        if (!sel) return;

        function checkCat() {
            var txt = sel.options[sel.selectedIndex]
                ? sel.options[sel.selectedIndex].text.toLowerCase().trim()
                : '';

            var boxR = document.getElementById('box-reservation');
            var boxA = document.getElementById('box-activite');

            if (boxR) boxR.classList.remove('show');
            if (boxA) boxA.classList.remove('show');

            if (txt.indexOf('servation') !== -1) {
                if (boxR) boxR.classList.add('show');
            } else if (txt.indexOf('activit') !== -1) {
                if (boxA) boxA.classList.add('show');
            }
        }

        sel.addEventListener('change', checkCat);
        checkCat(); // exécuter au chargement
    })();
});

async function suggestIA() {
    const btn = document.querySelector('.btn-ia');
    const result = document.getElementById('ia-result');
    const titre   = (document.getElementById('inp-titre')?.value||'').trim();
    const contenu = (document.getElementById('inp-desc')?.value||'').trim();
    if (!titre && !contenu) { alert("Remplissez le titre et/ou le contenu d'abord."); return; }
    btn.textContent='⏳ Analyse en cours…'; btn.disabled=true; result.style.display='none';
    try {
        const fd=new FormData(); fd.append('titre',titre); fd.append('contenu',contenu);
        const res=await fetch('{{ path("reclamation_suggest_priority") }}',{method:'POST',body:fd});
        const data=await res.json();
        const p=data.priorite||'Moyenne';
        const icons={Urgente:'🚨',Haute:'⚠️',Moyenne:'🔵',Basse:'🟢'};
        document.querySelectorAll('.prio-btn').forEach(b=>b.className='prio-btn');
        document.querySelectorAll('.prio-btn').forEach(b=>{if(b.dataset.val===p)b.classList.add('sel-'+p.toLowerCase());});
        const hp=document.getElementById('hidden-prio'); if(hp) hp.value=p;
        result.innerHTML=`<strong>${icons[p]||''} L'IA suggère : ${p}</strong><br><span style="font-size:0.82rem;opacity:0.8">${data.raison||''}</span>`;
        result.style.display='block';
    } catch(e) { result.innerHTML="⚠️ Impossible d'obtenir une suggestion."; result.style.display='block'; }
    finally { btn.innerHTML="🤖 Suggérer la priorité avec l'IA"; btn.disabled=false; }
}
</script>
{% endblock %}