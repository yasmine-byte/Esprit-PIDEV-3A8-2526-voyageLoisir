{# templates/chatbot/chatbot_widget.html.twig #}
<style>
    /* Nouveau design Chatbot assorti au template */
    #chatbot-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 350px;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(243, 85, 37, 0.15);
        display: none;
        flex-direction: column;
        z-index: 1000;
        overflow: hidden;
        border: 1px solid #ffebe6;
    }
    #chatbot-header {
        background: linear-gradient(135deg, #f35525 0%, #ff8966 100%);
        color: white;
        padding: 15px;
        font-weight: bold;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #eb4a19;
    }
    #chatbot-close {
        cursor: pointer;
        font-size: 18px;
    }
    #chat-messages {
        height: 300px;
        overflow-y: auto;
        padding: 15px;
        background: #f9f9f9;
    }
    .user-message, .bot-message {
        margin-bottom: 10px;
        padding: 8px 12px;
        border-radius: 15px;
        max-width: 80%;
        word-wrap: break-word;
    }
    .user-message {
        background: #f35525;
        color: white;
        align-self: flex-end;
        margin-left: auto;
        border-bottom-right-radius: 2px;
        box-shadow: 0 2px 5px rgba(243, 85, 37, 0.3);
    }
    .bot-message {
        background: #e9ecef;
        color: black;
        align-self: flex-start;
        margin-right: auto;
    }
    #chatbot-input-area {
        display: flex;
        border-top: 1px solid #ddd;
        padding: 10px;
    }
    #chat-input {
        flex: 1;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 5px;
        outline: none;
    }
    #chat-send {
        background: #f35525;
        color: white;
        border: none;
        padding: 8px 18px;
        margin-left: 10px;
        border-radius: 20px;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.3s ease;
    }
    #chat-send:hover {
        background: #d94215;
    }
    #chat-send:active {
        background: #be350d;
    }
    .loader {
        border: 3px solid #f3f3f3;
        border-top: 3px solid #f35525;
        border-radius: 50%;
        width: 15px;
        height: 15px;
        animation: spin 1s linear infinite;
        display: inline-block;
        margin-left:5px;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>

{# Bouton flottant pour ouvrir le chatbot #}
<button id="chatbot-btn" style="
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f35525 0%, #ff8966 100%);
    color: white;
    border: none;
    font-size: 22px;
    cursor: pointer;
    z-index: 9999;
    box-shadow: 0 4px 15px rgba(243, 85, 37, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
" title="Assistant IA">💬</button>

<div id="chatbot-container" style="position: fixed; bottom: 20px; right: 20px; z-index:9999; border-radius: 15px; overflow:hidden;">
    <div id="chatbot-header">
        <span>🤖 Assistant IA Réclamations</span>
        <span id="chatbot-close">✕</span>
    </div>
    <div id="chat-messages">
        <div class="bot-message">Bonjour ! Je suis l'assistant de VoyageLoisir. Voulez-vous créer une réclamation ? Quel est le motif ?</div>
    </div>
    <div id="chatbot-input-area">
        <input type="text" id="chat-input" placeholder="Écrivez votre message...">
        <button id="chat-send">Envoyer</button>
    </div>
</div>

{# jQuery est déjà inclus dans le layout de base #}
<script>
$(document).ready(function() {
    let conversationHistory = [];

    // Fonction pour ajouter un message au chat
    function addMessage(text, role) {
        const cls = role === 'user' ? 'user-message' : 'bot-message';
        $('#chat-messages').append('<div class="' + cls + '">' + (role === 'bot' ? text : escapeHtml(text)) + '</div>');
        $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
    }

    // Fonction globale pour ouvrir le chatbot depuis l'extérieur
    window.openChatbot = function() {
        $('#chatbot-btn').click();
    };

    // Fonction pour créer avis/réclamation depuis le chatbot
    async function createFromChatbot(data) {
        try {
            const response = await fetch('/chatbot/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                // Afficher message de succès dans le chat
                addMessage(
                    result.type === 'avis'
                        ? '✅ Votre avis a été enregistré avec succès ! Un email de confirmation vous a été envoyé. Vous pouvez le retrouver dans votre profil → Mes Feedbacks.'
                        : '✅ Votre réclamation a été enregistrée avec succès ! Un email de confirmation vous a été envoyé. Vous pouvez la retrouver dans votre profil → Mes Feedbacks.',
                    'bot'
                );
                // Lien vers le profil
                setTimeout(() => {
                    addMessage('👉 <a href="/profile" style="color:#d4845a;font-weight:700;">Voir dans mon profil →</a>', 'bot');
                }, 800);
            }
        } catch(e) {
            console.error('Erreur création depuis chatbot:', e);
        }
    }

    $('#chatbot-btn').click(function() {
        $(this).hide();
        $('#chatbot-container').css('display', 'flex');
        $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
    });

    $('#chatbot-close').click(function() {
        $('#chatbot-container').hide();
        $('#chatbot-btn').show();
    });

    function sendMessage() {
        let message = $('#chat-input').val().trim();
        if (message === '') return;

        $('#chat-messages').append('<div class="user-message">' + escapeHtml(message) + '</div>');
        $('#chat-input').val('');

        conversationHistory.push({role: 'user', content: message});

        let $loader = $('<div class="bot-message"><span class="loader"></span> Patientez...</div>');
        $('#chat-messages').append($loader);
        $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);

        // Détecter DIRECTEMENT si c'est une réclamation ou un avis AVANT d'appeler l'IA
        var msgLower = message.toLowerCase();
        var isReclamation = msgLower.indexOf('réclamation') !== -1 ||
                            msgLower.indexOf('reclamation') !== -1 ||
                            msgLower.indexOf('problème') !== -1 ||
                            msgLower.indexOf('probleme') !== -1 ||
                            msgLower.indexOf('plainte') !== -1 ||
                            msgLower.indexOf('chambre') !== -1 ||
                            msgLower.indexOf('hôtel') !== -1 ||
                            msgLower.indexOf('hotel') !== -1 ||
                            msgLower.indexOf('sale') !== -1 ||
                            msgLower.indexOf('mauvais') !== -1 ||
                            msgLower.indexOf('panne') !== -1 ||
                            msgLower.indexOf('broken') !== -1 ||
                            msgLower.indexOf('service client') !== -1 ||
                            msgLower.indexOf('remboursement') !== -1 ||
                            msgLower.indexOf('annul') !== -1;

        var isAvis = (msgLower.indexOf('avis') !== -1 ||
                      msgLower.indexOf('étoile') !== -1 ||
                      msgLower.indexOf('etoile') !== -1 ||
                      msgLower.indexOf('note') !== -1 ||
                      msgLower.indexOf('★') !== -1) && !isReclamation;

        if (isReclamation) {
            $loader.remove();
            $('#chat-messages').append('<div class="bot-message">✨ Création de votre réclamation...</div>');
            $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);

            $.post('/chatbot/submit-reclamation', {
                titre: message.substring(0, 100),
                contenu: message,
                priorite: 'Moyenne'
            }, function(res) {
                if (res.success) {
                    $('#chat-messages').append(
                        '<div class="bot-message" style="background:linear-gradient(135deg,#d4845a,#e8a87c);color:white;border-radius:12px;padding:12px 16px;">' +
                        '✅ Réclamation <strong>#' + res.id + '</strong> créée avec succès !<br>' +
                        '<small style="opacity:0.85;">Un email de confirmation vous a été envoyé.</small>' +
                        '</div>'
                    );
                    setTimeout(function(){ window.location.reload(); }, 2500);
                } else {
                    $('#chat-messages').append(
                        '<div class="bot-message" style="color:red;">❌ ' + (res.message || 'Erreur. Réessayez.') + '</div>'
                    );
                }
                $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
            }).fail(function(xhr) {
                $('#chat-messages').append(
                    '<div class="bot-message" style="color:red;">❌ Erreur serveur : ' + xhr.status + '. Réessayez.</div>'
                );
                $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
            });
            return;
        }

        if (isAvis) {
            $loader.remove();
            var nbEtoiles = 3;
            var etoilesMatch = message.match(/([1-5])\s*[éeEÉ]toile/i) || message.match(/([1-5])\s*★/);
            if (etoilesMatch) nbEtoiles = parseInt(etoilesMatch[1]);

            $('#chat-messages').append('<div class="bot-message">⭐ Création de votre avis...</div>');
            $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);

            $.post('/chatbot/submit-avis', {
                contenu: message,
                nbEtoiles: nbEtoiles,
                type: 'Service Client'
            }, function(res) {
                if (res.success) {
                    $('#chat-messages').append(
                        '<div class="bot-message" style="background:linear-gradient(135deg,#d4845a,#e8a87c);color:white;border-radius:12px;padding:12px 16px;">' +
                        '✅ Avis <strong>#' + res.id + '</strong> créé avec succès !' +
                        (res.reclamation_auto ? '<br><small style="opacity:0.85;">⚠️ Note basse détectée — une réclamation a été créée automatiquement.</small>' : '<br><small style="opacity:0.85;">Un email de confirmation vous a été envoyé.</small>') +
                        '</div>'
                    );
                    setTimeout(function(){ window.location.reload(); }, 2500);
                } else {
                    $('#chat-messages').append(
                        '<div class="bot-message" style="color:red;">❌ ' + (res.message || 'Erreur. Réessayez.') + '</div>'
                    );
                }
                $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
            }).fail(function(xhr) {
                $('#chat-messages').append(
                    '<div class="bot-message" style="color:red;">❌ Erreur serveur : ' + xhr.status + '. Réessayez.</div>'
                );
                $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
            });
            return;
        }

        // Si ni réclamation ni avis → réponse normale de l'IA
        $.post('/chatbot/ask', {
            message: message,
            history: JSON.stringify(conversationHistory)
        }, function(data) {
            $loader.remove();
            var txt = data.response || 'Je suis là pour vous aider à créer une réclamation ou un avis.';
            conversationHistory.push({role: 'assistant', content: txt});
            $('#chat-messages').append('<div class="bot-message">' + escapeHtml(txt) + '</div>');
            $('#chat-messages').scrollTop($('#chat-messages')[0].scrollHeight);
        }).fail(function() {
            $loader.remove();
            $('#chat-messages').append('<div class="bot-message" style="color:red;">Erreur de communication.</div>');
        });
    }

    $('#chat-send').click(sendMessage);
    $('#chat-input').keypress(function(e) {
        if(e.which == 13) { sendMessage(); }
    });

    function escapeHtml(unsafe) {
        return unsafe
             .replace(/&/g, "&amp;")
             .replace(/</g, "&lt;")
             .replace(/>/g, "&gt;")
             .replace(/"/g, "&quot;")
             .replace(/'/g, "&#039;");
    }
});
</script>
